# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=prod

# --- public address ---------------------------------------------------------
# SITE_ADDRESS  = what Caddy serves on:
#   real domain  -> civicpulse.example.com   (Caddy gets auto-HTTPS)
#   tunnel       -> :80                       (Cloudflare/ngrok terminates TLS)
#   local prod   -> localhost
# SITE_URL      = the public base URL the browser uses (scheme + host).
#   Baked into the frontend at build AND used as the presigned-photo origin.
SITE_ADDRESS=localhost
SITE_URL=https://localhost
PUBLIC_S3_ENDPOINT_URL=https://localhost
CORS_ORIGINS=["https://localhost"]

# --- secrets ----------------------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_a_48_byte_secret
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=civicpulse
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME_strong_password
S3_BUCKET=civicpulse-media

# --- AI ---------------------------------------------------------------------
# Leave MOCK_AI=true to run fully offline (deterministic). To use real Gemini
# (titles, classification fallback, photo vision, report narration):
#   MOCK_AI=false  and set GEMINI_API_KEY
MOCK_AI=true
GEMINI_API_KEY=
