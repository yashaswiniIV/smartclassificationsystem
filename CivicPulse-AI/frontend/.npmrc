# Throttle parallel registry fetches + add retries — Docker's NAT makes many
# parallel tarball pulls flaky (curl error 23) on some hosts.
fetch-retries=5
fetch-retry-maxtimeout=120000
network-concurrency=4
# Don't re-verify/purge node_modules before `pnpm build` — in our multi-stage
# Docker build node_modules is copied from the deps stage, which trips a false
# "out of date" check that aborts with no TTY. We install explicitly; skip it.
verify-deps-before-run=false
