# Single public origin for the whole app. One origin is REQUIRED so the httpOnly
# refresh cookie (SameSite=Lax) is sent on /api/v1/auth calls.
#
# SITE_ADDRESS:
#   - a real domain (e.g. civicpulse.example.com) → Caddy gets auto-HTTPS
#   - ":80" → plain HTTP, e.g. behind a Cloudflare tunnel that terminates TLS
#   - "localhost" → local prod with a locally-trusted cert
{$SITE_ADDRESS:localhost} {
	encode gzip

	# Presigned photo URLs are signed against this same public origin
	# (S3_ENDPOINT_URL), so the bucket path must proxy to MinIO WITHOUT rewriting
	# (path-style signatures cover the full /bucket/key path).
	handle /civicpulse-media/* {
		reverse_proxy minio:9000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
