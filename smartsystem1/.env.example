# Copy to backend/.env for native dev:  Copy-Item .env.example backend\.env
# docker-compose services receive their env directly from docker-compose.yml.

ENV=dev
DATABASE_URL=postgresql+asyncpg://civicpulse:civicpulse@localhost:5432/civicpulse
REDIS_URL=redis://localhost:6379/0

# auth — generate a real one for prod: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-32-bytes-min!!

# object storage (MinIO in dev; swap to R2/S3 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=civicpulse
S3_SECRET_KEY=civicpulse123
S3_BUCKET=civicpulse-media

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# AI — MOCK_AI=true runs the whole platform offline with deterministic fixtures
MOCK_AI=true
GEMINI_API_KEY=
